# Zetsu - FDR / Security Deposit Management Portal
# Environment Configuration

# Environment mode: development, staging, production
ENVIRONMENT=development
PROJECT_NAME="Zetsu - AICTE FDR Portal"
DEBUG=True

# Backend API
API_V1_STR=/api/v1
SECRET_KEY=zetsu-super-secret-key-change-in-production-aicte-2026
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL for Docker/Production; SQLite fallback for local dev if Postgres is not configured)
DATABASE_URL=sqlite+aiosqlite:///./zetsu.db
# DATABASE_URL=postgresql+asyncpg://zetsu_user:zetsu_pass@localhost:5432/zetsu_db

# Redis (for Celery & caching)
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO or S3, local storage directory fallback)
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./storage_uploads
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=zetsu-documents
MINIO_SECURE=False

# OCR Configuration
OCR_ENGINE=mock_and_extract # mock_and_extract, paddleocr, tesseract

# Email / Notifications (Mailhog in dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=no-reply@aicte-india.org
EMAILS_FROM_NAME="AICTE Zetsu FDR Portal"

# Frontend URL
FRONTEND_URL=http://localhost:3000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
